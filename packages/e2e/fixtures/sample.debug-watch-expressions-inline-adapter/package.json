{
  "name": "debug-watch-expressions-inline-adapter",
  "displayName": "Debug Watch Expressions Inline Adapter",
  "publisher": "memory-leak-fixtures",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "watch-inline",
