{
  "name": "@vscode-memory-leak-finder/build",
  "version": "0.0.0-dev",
  "license": "MIT",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:watch": "rollup -c rollup.config.js -w",
    "backport-prs": "node src/backportMergedPrs.ts",
    "analyze-heap-retainers": "node --max-old-space-size=8192 src/analyzeHeapRetainers.ts",
    "analyze-ipc-messages-from-start": "node src/analyzeIpcMessagesFromStart.ts",
    "generate-api-types": "node src/generate-api-types.ts",
    "measure-local-vscode-comparison": "node src/measureLocalVscodeComparison.ts",
    "measure-codex-webview-load-time": "node src/measureCodexWebviewLoadTime.ts",
    "measure-warm-codex-webview-load-time": "node src/measureCodexWebviewLoadTime.ts --warm-cache",
    "measure-webview-memory": "node src/measureWebviewMemory.ts",
    "measure-webview-load-time": "node src/measureWebviewLoadTime.ts",
    "memory-leak-report": "node src/memoryLeakReport.ts",
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "dts-bundle-generator": "^9.5.1",
    "rollup": "^4.63.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@lvce-editor/assert": "^1.9.0"
  }
}
