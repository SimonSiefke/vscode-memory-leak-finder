{
  "name": "@vscode-memory-leak-finder/visualizations",
  "version": "0.0.0-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./retainer-river/report": "./src/retainerRiver/report.ts"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "generate": "node src/generate.ts",
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "jest": {
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "injectGlobals": false,
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.182.0",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "typescript": "^6.0.3"
  }
}
