+import { ipcRenderer } from '../../../../base/parts/sandbox/electron-browser/globals.js';
+
+
+export class NativeStartupBenchmark implements IWorkbenchContribution {
+
+	constructor(
+		@ITimerService private readonly _timerService: ITimerService,
+		@INativeWorkbenchEnvironmentService environmentService: INativeWorkbenchEnvironmentService,
+		@IProductService private readonly _productService: IProductService
+	) {
+		if (environmentService.args['memory-leak-finder-benchmark-startup']) {
+			this._run().catch(error => ipcRenderer.send('vscode:memoryLeakFinderBenchmarkStartup', { error: String(error) }));
+		}
+	}
+
+	private async _run(): Promise<void> {
+		await this._timerService.whenReady();
+
+		const rendererReadyTime = performance.now();
+		const rendererReadyAbsoluteTime = performance.timeOrigin + rendererReadyTime;
+		const mainStartTime = this._timerService.getStartTime('code/didStartMain');
+		const rendererMarks = performance.getEntriesByType('mark').map(entry => ({
+			name: entry.name,
+			startTime: entry.startTime,
+			absoluteStartTime: performance.timeOrigin + entry.startTime
+		}));
+
+		ipcRenderer.send('vscode:memoryLeakFinderBenchmarkStartup', {
+			type: 'vscode-startup-benchmark',
+			schemaVersion: 1,
+			commit: this._productService.commit,
+			milestone: 'timerService.whenReady',
+			performanceTimeOrigin: performance.timeOrigin,
+			rendererReadyTime,
+			rendererReadyAbsoluteTime,
+			mainStartTime,
+			mainToTimerReady: mainStartTime >= 0 ? rendererReadyAbsoluteTime - mainStartTime : undefined,
+			startupMetrics: this._timerService.startupMetrics,
+			performanceMarks: this._timerService.getPerformanceMarks().map(([source, marks]) => ({ source, marks })),
+			rendererMarks
+		});
+	}
+}
 
