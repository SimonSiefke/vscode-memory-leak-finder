{
  "name": "vscode-memory-leak-finder",
  "version": "0.0.0-dev",
  "description": "",
  "main": "src/main.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "e2e:check-flakyness": "npm run e2e:check-flakyness --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present",
    "e2e:agents": "node packages/cli/bin/test.js --cwd packages/agents-e2e --launch-agent-window --enable-extensions --use-proxy-mock",
    "format": "prettier --write .",
    "install:ci": "node packages/build/src/parts/Install/Install.js",
    "lint": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "type-check": "tsc -b",
    "build-charts": "node packages/charts/src/main.ts",
    "large-performance": "node packages/large-benchmark/src/main.ts",
    "large-performance:prepare": "node packages/large-benchmark/src/main.ts prepare",
    "large-performance:measure": "node packages/large-benchmark/src/main.ts measure",
    "large-performance:smoke": "node packages/large-benchmark/src/main.ts smoke",
    "large-performance:report": "node packages/large-benchmark/src/main.ts report",
    "measure-local-vscode-comparison": "npm --prefix packages/build run measure-local-vscode-comparison --",
    "measure-codex-webview-load-time": "npm --prefix packages/build run measure-codex-webview-load-time --",
    "measure-warm-codex-webview-load-time": "npm --prefix packages/build run measure-warm-codex-webview-load-time --",
    "measure-webview-memory": "npm --prefix packages/build run measure-webview-memory --",
    "backport-prs": "npm --prefix packages/build run backport-prs --",
    "e2e:electron": "node packages/electron-e2e/src/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonSiefke/vscode-memory-leak-finder.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SimonSiefke/vscode-memory-leak-finder/issues"
  },
  "homepage": "https://github.com/SimonSiefke/vscode-memory-leak-finder#readme",
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "execa": "^10.2.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "ws": "^8.22.1"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/.vscode-test/"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 140
  }
}
